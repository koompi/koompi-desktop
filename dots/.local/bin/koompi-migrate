#!/usr/bin/env bash
# koompi-migrate - bring an existing user's KOOMPI desktop up to the packaged defaults.
#
# /etc/skel only seeds NEW users; a package upgrade changes nothing in an
# existing $HOME. This closes that gap: it syncs the KOOMPI-owned code trees
# (shell QML, shipped Hyprland modules) from the packaged defaults into the
# user config, taking a tar backup first.
#
# Never touched by the sync, by design:
#   ~/.config/koompi/            user data; config.json is the source of truth
#   ~/.config/hypr/custom/       user overrides
#   ~/.config/hypr/monitors.lua, workspaces.conf   machine-local
#   ~/.config/hypr/hyprlock.conf, hypridle.conf    machine-tuned
#   ~/.config/hypr/hyprland/shellOverrides/main.lua  written by the shell (Game
#                          mode, Reduce Motion); the shipped stub only where missing
# `refresh <path>` is the one deliberate exception: it puts the packaged copy
# of the single file you name back, after backing yours up.
#
# Dry run by default; the sync changes nothing without --apply.
set -euo pipefail

SELF="$(readlink -f -- "$0" 2>/dev/null || echo "$0")"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${KOOMPI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/koompi}"
BACKUP_DIR="$STATE_DIR/backups"
LOG_FILE="$STATE_DIR/logs/migrate.log"
CONFIG_FILE="${KOOMPI_CONFIG_FILE:-$XDG_CONFIG_HOME/koompi/config.json}"
MIGRATIONS_MARKER_DIR="$STATE_DIR/migrations"
# Packaged defaults, best source first: the koompi-shell package tree, then
# the /etc/skel seed shipped by koompi-hyprland-config. The env overrides
# exist so the flow is testable without installed packages.
SKEL="${KOOMPI_MIGRATE_SKEL:-/etc/skel}"
XDG_SYS="${KOOMPI_MIGRATE_XDG:-/etc/xdg}"

die() { echo "koompi-migrate: $*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Usage: koompi-migrate [--apply]
       koompi-migrate --pending
       koompi-migrate run [--hold]
       koompi-migrate notify
       koompi-migrate refresh <path-under-~>
       koompi-migrate new <slug>

Sync the KOOMPI-owned code trees (shell QML, shipped Hyprland modules) from
the packaged defaults into your user config. Without --apply this is a dry
run that only reports what would change.

--apply backs up the affected trees to ~/.local/state/koompi/backups/ as a
tarball before changing anything. Your Hyprland overrides
(~/.config/hypr/custom/) and machine-local files (monitors.lua,
workspaces.conf, hyprlock.conf, hypridle.conf) are never touched. Hyprland's
config autoreload is paused while hyprland/ is written and reloaded once
after. ~/.config/koompi/config.json keeps every value you set; only defaults
you never changed are brought up to the packaged ones (backed up first as
config.json.bak-<timestamp>), using the snapshot saved by the last update.
`koompi update` runs --apply after a packaged upgrade, with
KOOMPI_MIGRATE_NO_RELOAD set so that it leaves the one reload to the update.

--pending lists point-fix migrations (sdata/migrations/) not yet applied for
this user; exits 0 if any are pending, 1 if none. They are read from the
checkout this copy runs from, the checkout ./setup recorded in
~/.local/state/koompi/repo-path, and /usr/share/koompi/migrations.

run applies every pending migration in order, recording completion per user
under ~/.local/state/koompi/migrations/. A failing migration stops the run
and later ones are left pending. --hold waits for Enter afterwards, for the
terminal the notification opens. `koompi update` runs it before it reloads the
shell.

notify is what koompi-migrate-notify.service runs at login: with migrations
pending, it waits for the shell's notification server and sends a toast whose
click opens a terminal running `koompi-migrate run --hold`.

refresh <path> puts the packaged default back for one file, e.g.
`refresh .config/hypr/hypridle.conf`. Your copy is saved under
~/.local/state/koompi/backups/ first and the diff between them is printed.

new <slug> writes a migration skeleton, sdata/migrations/<unix-ts>-<slug>.sh,
into this checkout (refuses elsewhere). See docs/agents/migrations.md.
USAGE
}

# every source this machine has: a packaged machine that updates from a checkout has two
migration_sources() {
    local repo dir
    if [[ -n "${KOOMPI_MIGRATE_MIGRATIONS_DIR:-}" ]]; then
        printf '%s\n' "$KOOMPI_MIGRATE_MIGRATIONS_DIR"
        return 0
    fi
    for repo in "$(cd -- "$(dirname -- "$SELF")/../../.." 2>/dev/null && pwd)" "$(cat -- "$STATE_DIR/repo-path" 2>/dev/null)"; do
        if [[ -n "$repo" && -d "$repo/sdata/migrations" ]]; then printf '%s\n' "$repo/sdata/migrations"; fi
    done
    # the first is the relative twin of the second, so a staged package tree works as it stands
    for dir in "$(dirname -- "$SELF")/../share/koompi/migrations" /usr/share/koompi/migrations; do
        if [[ -d "$dir" ]]; then printf '%s\n' "$dir"; fi
    done
}

# name<TAB>path for each migration this user has not run, oldest first (same-width unix timestamps sort
# chronologically); a name found in more than one source is one migration, taken from the first
pending_migrations() {
    local dir f name
    local -A seen=()
    while IFS= read -r dir; do
        for f in "$dir"/*.sh; do
            [[ -e "$f" ]] || continue
            name="${f##*/}"
            [[ -z "${seen[$name]:-}" && ! -e "$MIGRATIONS_MARKER_DIR/$name" ]] || continue
            seen[$name]=1
            printf '%s\t%s\n' "$name" "$f"
        done
    done < <(migration_sources) | LC_ALL=C sort
}

# the non-sync subcommands live next door (dots tree, staged package tree, installed package); fail loud rather than run without them
migrate_lib=""
for candidate in \
    "$(dirname -- "$SELF")/../share/koompi/libexec/migrate-lib.sh" \
    "$(dirname -- "$SELF")/../lib/koompi/migrate-lib.sh" \
    /usr/lib/koompi/migrate-lib.sh \
    "${XDG_DATA_HOME:-$HOME/.local/share}/koompi/libexec/migrate-lib.sh"; do
    [[ -f "$candidate" ]] && { migrate_lib="$candidate"; break; }
done
[[ -n "$migrate_lib" ]] || die "migrate-lib.sh not found next to this script or in /usr/lib/koompi; reinstall koompi-shell"
# shellcheck source=../share/koompi/libexec/migrate-lib.sh
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../share/koompi/libexec/migrate-lib.sh
source "$migrate_lib"

mode=resync
apply=false
arg="${2:-}"
case "${1:-}" in
    --apply) apply=true ;;
    --pending) mode=pending ;;
    run) mode=run ;;
    notify) mode=notify ;;
    refresh) mode=refresh; [[ -n "$arg" ]] || die "refresh needs a path, e.g. refresh .config/hypr/hypridle.conf" ;;
    new) mode=new; [[ -n "$arg" ]] || die "new needs a slug, e.g. new relink-nvim-theme" ;;
    -h|--help|help) usage; exit 0 ;;
    "") ;;
    *) echo "koompi-migrate: unknown argument '$1'" >&2; usage >&2; exit 1 ;;
esac

case "$mode" in
    notify) notify_pending; exit 0 ;;
    refresh) refresh_file "$arg"; exit 0 ;;
    new) new_migration "$arg"; exit 0 ;;
esac

if [[ "$mode" == pending ]]; then
    mapfile -t pending < <(pending_migrations)
    [[ ${#pending[@]} -gt 0 ]] || exit 1
    printf '%s\n' "${pending[@]%%$'\t'*}"
    exit 0
fi

if [[ "$mode" == run && "$arg" == --hold ]]; then
    rc=0
    "$SELF" run || rc=$?
    printf '\nPress Enter to close this window.'
    [[ ! -t 0 ]] || read -rs
    exit "$rc"
fi

if [[ "$mode" == run ]]; then
    mapfile -t pending < <(pending_migrations)
    if [[ ${#pending[@]} -eq 0 ]]; then
        echo "koompi-migrate: no pending migrations"
        exit 0
    fi
    mkdir -p "$MIGRATIONS_MARKER_DIR"
    for entry in "${pending[@]}"; do
        name="${entry%%$'\t'*}"
        echo "koompi-migrate: running $name"
        if bash -euo pipefail "${entry#*$'\t'}"; then
            : > "$MIGRATIONS_MARKER_DIR/$name"
        else
            echo "koompi-migrate: FAILED $name; stopping, later migrations left pending" >&2
            exit 1
        fi
    done
    echo "koompi-migrate: all pending migrations complete"
    exit 0
fi

command -v rsync >/dev/null || die "rsync required"

shell_src=""
for d in "$XDG_SYS/quickshell/koompi" "$SKEL/.config/quickshell/koompi"; do
    [[ -d "$d" ]] && { shell_src="$d"; break; }
done
hypr_src=""
[[ -d "$SKEL/.config/hypr/hyprland" ]] && hypr_src="$SKEL/.config/hypr"

if [[ -z "$shell_src" && -z "$hypr_src" ]]; then
    die "no packaged defaults found (install koompi-shell or koompi-hyprland-config)"
fi

# Each pair is "src|dst|extra rsync args". A missing dst is skipped: that tree
# runs straight off the packaged defaults, syncing would freeze a stale copy.
pairs=()
[[ -n "$shell_src" ]] && pairs+=("$shell_src/|$XDG_CONFIG_HOME/quickshell/koompi/|")
if [[ -n "$hypr_src" ]]; then
    hypr_extra="--exclude=colors.lua"
    [[ -e "$XDG_CONFIG_HOME/hypr/hyprland/shellOverrides/main.lua" ]] && hypr_extra+=" --exclude=/shellOverrides/main.lua"
    pairs+=("$hypr_src/hyprland/|$XDG_CONFIG_HOME/hypr/hyprland/|$hypr_extra")
    [[ -f "$hypr_src/hyprland.lua" ]] && pairs+=("$hypr_src/hyprland.lua|$XDG_CONFIG_HOME/hypr/hyprland.lua|")
fi

echo "koompi-migrate: $($apply && echo applying || echo 'dry run (use --apply to make changes)')"

changes=0
dirty=()
hypr_dirty=false
for pair in "${pairs[@]}"; do
    IFS='|' read -r src dst extra <<<"$pair"
    if [[ ! -e "$dst" ]]; then
        echo "  skip  ${dst/#$HOME/\~}  (absent: runs packaged defaults directly)"
        continue
    fi
    # -c: compare by content, not size+mtime; skel-seeded copies share sizes
    # but never install times, so the quick check is wrong in both directions.
    # shellcheck disable=SC2086  # extra is deliberately word-split rsync args
    delta="$(rsync -nac --itemize-changes --delete $extra "$src" "$dst" | grep -vc '^\.d' || true)"
    if [[ "$delta" -eq 0 ]]; then
        echo "  ok    ${dst/#$HOME/\~}  (up to date)"
    else
        echo "  sync  ${dst/#$HOME/\~}  ($delta changes from $src)"
        changes=$((changes + delta))
        dirty+=("$pair")
        [[ "$dst" != "$XDG_CONFIG_HOME/hypr/"* ]] || hypr_dirty=true
    fi
done

if $apply && [[ "$changes" -gt 0 ]]; then
    mkdir -p "$BACKUP_DIR"
    tarball="$BACKUP_DIR/migrate-$(date +%Y%m%d-%H%M%S).tar.gz"
    rels=()
    for pair in "${dirty[@]}"; do
        IFS='|' read -r _ dst _ <<<"$pair"
        rels+=("${dst#"$HOME"/}")
    done
    tar -C "$HOME" -czf "$tarball" "${rels[@]}"
    echo "  backup written: ${tarball/#$HOME/\~}"
    ! $hypr_dirty || pause_autoreload
    for pair in "${dirty[@]}"; do
        IFS='|' read -r src dst extra <<<"$pair"
        # shellcheck disable=SC2086
        rsync -ac --delete $extra "$src" "$dst"
    done
    # Reload while the watcher is still off, then hand the option back: the
    # reload records the new mtimes, so re-enabling does not trigger a second one.
    if [[ -n "$autoreload_prev" ]]; then
        # koompi update reloads once, last
        if [[ -z "${KOOMPI_MIGRATE_NO_RELOAD:-}" ]]; then
            hyprctl reload >/dev/null && echo "  hyprland config reloaded" \
                || echo "  note  hyprctl reload failed; run 'koompi reload'" >&2
        fi
        resume_autoreload
    fi
fi

# Config defaults migration (B2): code trees above are synced wholesale, but a
# user's config.json keeps whatever defaults their first run wrote. Merge the
# packaged defaults over it three-way, exactly like the packaged update route:
# user values win, untouched defaults follow the package. Old defaults come
# from ~/.local/state/koompi/config-defaults.json - the snapshot every update
# saves; without one there is no honest baseline, so this run only starts
# tracking. The engine lives in libexec/update so both routes cannot drift.
migrate_config_defaults() {
    local tool new_dump snapshot had_snapshot=false
    for tool in \
        "$(dirname -- "$SELF")/../share/koompi/libexec/update" \
        /usr/lib/koompi/update \
        "${XDG_DATA_HOME:-$HOME/.local/share}/koompi/libexec/update"; do
        [[ -x "$tool" ]] && break
        tool=""
    done
    if [[ -z "$tool" ]]; then
        echo "  skip  config defaults migration (koompi's update engine not found)" >&2
        return 0
    fi
    [[ -d "$XDG_SYS/quickshell/koompi" ]] || return 0

    new_dump="$(mktemp)"
    if ! "$tool" dump-defaults "$XDG_SYS/quickshell/koompi" "$new_dump"; then
        echo "  skip  config defaults migration (defaults could not be dumped)" >&2
        rm -f "$new_dump"
        return 1
    fi

    snapshot="$STATE_DIR/config-defaults.json"
    [[ -s "$snapshot" ]] && had_snapshot=true
    local dry="true"; $apply && dry="false"
    if $had_snapshot; then
        KOOMPI_UPDATE_DRY_RUN="$dry" "$tool" apply-defaults-migration \
            "$snapshot" "$new_dump" true || { rm -f "$new_dump"; return 1; }
    else
        KOOMPI_UPDATE_DRY_RUN="$dry" "$tool" apply-defaults-migration \
            "" "$new_dump" false || { rm -f "$new_dump"; return 1; }
    fi
    rm -f "$new_dump"
    return 0
}

migrate_config_defaults

if [[ -f "$CONFIG_FILE" ]] && command -v jq >/dev/null; then
    ver="$(jq -r '.configVersion // "unset"' "$CONFIG_FILE" 2>/dev/null || echo unreadable)"
    echo "  config.json settings kept as the merge left them (configVersion: $ver)"
fi

mkdir -p "$(dirname "$LOG_FILE")"
printf '%s %s changes=%s\n' "$(date -Iseconds)" "$($apply && echo apply || echo dry-run)" "$changes" >> "$LOG_FILE"

if $apply && [[ "$changes" -gt 0 ]]; then
    restart_note=" Restart the shell (or log out and back in) to load it."
    [[ -z "${KOOMPI_MIGRATE_NO_RELOAD:-}" ]] || restart_note=""
    echo "koompi-migrate: done.$restart_note"
elif ! $apply && [[ "$changes" -gt 0 ]]; then
    echo "koompi-migrate: $changes pending changes. Run 'koompi-migrate --apply' to sync."
else
    echo "koompi-migrate: everything up to date."
fi
