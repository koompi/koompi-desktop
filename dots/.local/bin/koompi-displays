#!/usr/bin/env bash
# koompi-displays - monitor layout and refresh rate for KOOMPI Settings
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
MONITORS_LUA="$XDG_CONFIG_HOME/hypr/monitors.lua"
STATE_DIR="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/koompi-displays}"
PENDING="${STATE_DIR:+$STATE_DIR/pending}"
CONFIRM_SECONDS="${KOOMPI_DISPLAYS_CONFIRM_SECONDS:-15}"
case $0 in /*) SELF=$0 ;; *) SELF=$PWD/$0 ;; esac
# two decimals like the compositor lists them; one cannot tell 74.97 from 75.00
JQ_MODE='def mode: "\(.width)x\(.height)@\(.refreshRate*100|round/100)";'

usage() {
    echo "usage: koompi-displays place <monitor> <left|right|above|below> [anchor]" >&2
    echo "       koompi-displays rate <monitor> <hz>   (switches; keep saves it, revert or ${CONFIRM_SECONDS} s of silence undoes it)" >&2
    echo "       koompi-displays keep | revert" >&2
    exit 1
}

# no koompi package depends on lua; the file is a fixed template filled by jq
validate_lua() {
    if command -v luac >/dev/null 2>&1; then
        luac -p "$1" 2>/dev/null
    elif command -v lua >/dev/null 2>&1; then
        lua -e "assert(loadfile('$1'))" 2>/dev/null
    fi
}

# desc: follows a display across ports; it matches by prefix, so an empty or prefixing description keeps the port; absent displays keep their rules; keys the writer does not know (vrr, bitdepth, cm, icc) are carried over
# a mirror names its source the same way; mirrorOf is the source's id and monitors -j hides mirrors, so persist reads monitors all -j
rules_program() {
    cat <<'JQ'
def lua: gsub("\\\\"; "\\\\") | gsub("\""; "\\\"");
map(select(.disabled != true)) as $mons
| ($mons | map(.description // "")) as $descs
| def rule_key($m): ($m.description // "") as $d
    | if $d != "" and ($d | test("\\p{Cntrl}") | not) and ($descs | map(select(startswith($d))) | length) == 1
      then "desc:" + ($d | lua) else ($m.name | lua) end;
  def mirror_of($m): ($m.mirrorOf // "none" | tostring) as $of
    | ($mons | map(select((.id | tostring) == $of or .name == $of)) | .[0]) as $src
    | if $src == null then "" else ",\n    mirror = \"\(rule_key($src))\"" end;
  [$old | match("hl\\.monitor\\(\\{\n[\\s\\S]*?\n\\}\\)"; "g").string
   | {k: capture("\n    output = \"(?<k>(?:[^\"\\\\]|\\\\.)*)\"").k,
      extra: [split("\n")[] | select(test("^    [A-Za-z_]+ = ")) | select(test("^    (output|mode|position|scale|transform|mirror) = ") | not) | sub(",$"; "")]}] as $olds
| def extras($m): [rule_key($m), ($m.name | lua), ($m.description // "" | if . == "" then empty else "desc:" + lua end)] as $ks
    | [$olds[] | select(.k as $k | $ks | any(. == $k)) | .extra[]] | reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end) | map(",\n" + .) | join("");
  ($mons | map("hl.monitor({\n    output = \"\(rule_key(.))\",\n    mode = \"\(mode)\",\n    position = \"\(.x)x\(.y)\",\n    scale = \(.scale),\n    transform = \(.transform // 0)\(mirror_of(.))\(extras(.))\n})")) as $fresh
| (($mons | map(.name | lua)) + ($descs | map(select(. != "") | "desc:" + lua))) as $taken
| [$old | match("hl\\.monitor\\(\\{\n[\\s\\S]*?\n\\}\\)"; "g").string
   | select((capture("\n    output = \"(?<k>(?:[^\"\\\\]|\\\\.)*)\"").k as $k | $taken | any(. == $k)) | not)] as $kept
| ($kept + $fresh) | join("\n")
JQ
}

persist_layout() {
    local rules tmp old=/dev/null
    if [ -f "$MONITORS_LUA" ]; then old=$MONITORS_LUA; fi
    rules=$(hyprctl monitors all -j | jq -r --rawfile old "$old" "$JQ_MODE$(rules_program)") || { echo "koompi-displays: could not read the monitors, not persisted" >&2; return 1; }
    tmp=$(mktemp "$MONITORS_LUA.XXXXXX") || return 1
    printf -- '-- Generated by koompi-displays. Do not edit manually.\n\n%s\n' "$rules" > "$tmp" || { rm -f "$tmp"; return 1; }
    if validate_lua "$tmp"; then
        mv "$tmp" "$MONITORS_LUA"
    else
        rm -f "$tmp"
        echo "koompi-displays: generated monitors.lua failed lua validation, not persisted" >&2
        return 1
    fi
}

apply_mode() {
    hyprctl eval "hl.monitor({output = \"$1\", mode = \"$2\", position = \"$3x$4\", scale = $5})" >/dev/null
}

apply_one() {
    local monjson="$1" name="$2" x="$3" y="$4" mode scale
    mode=$(jq -r --arg n "$name" "$JQ_MODE"'.[] | select(.name == $n) | mode' <<< "$monjson")
    scale=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .scale' <<< "$monjson")
    apply_mode "$name" "$mode" "$x" "$y" "$scale"
}

# the compositor's own report decides: a hyprctl that exits 0 can still have changed nothing
wait_for_rate() {
    local mon="$1" centi="$2"
    for _ in 1 2 3 4 5 6 7 8; do
        if hyprctl monitors -j | jq -e --arg m "$mon" --argjson c "$centi" \
            '.[] | select(.name == $m) | ((.refreshRate * 100 | round) - $c) as $d | $d >= -1 and $d <= 1' >/dev/null; then
            return 0
        fi
        sleep 0.3
    done
    return 1
}

need_state() {
    [ -n "$STATE_DIR" ] || { echo "koompi-displays: XDG_RUNTIME_DIR is not set" >&2; exit 1; }
    mkdir -p "$STATE_DIR"
}

# whoever renames the record away owns it: keep, revert and the timer never act twice
claim_pending() {
    local claim="$PENDING.$$"
    mv -- "$PENDING" "$claim" 2>/dev/null || return 1
    echo "$claim"
}

restore_from() {
    local rec="$1" fields mon mode x y scale centi
    fields=$(jq -er '"\(.monitor) \(.mode) \(.x) \(.y) \(.scale) \(.centi)"' "$rec") || { rm -f -- "$rec"; return 1; }
    rm -f -- "$rec"
    read -r mon mode x y scale centi <<< "$fields"
    apply_mode "$mon" "$mode" "$x" "$y" "$scale"
    wait_for_rate "$mon" "$centi" || { echo "koompi-displays: $mon did not go back to $mode" >&2; return 1; }
}

undo_pending() {
    local claim
    claim=$(claim_pending) || return 0
    restore_from "$claim" || true
}

print_pending() {
    local now
    printf -v now '%(%s)T' -1
    jq -c --argjson now "$now" '{monitor, rate: (.target / 100), previous: (.centi / 100), deadline, seconds: ([.deadline - $now, 0] | max)}' "$PENDING"
}

# a record past its deadline means the timer died: undo it before anything else changes
refuse_if_pending() {
    local now
    [ -n "$PENDING" ] && [ -e "$PENDING" ] || return 0
    printf -v now '%(%s)T' -1
    if (( now >= $(jq -r '.deadline // 0' "$PENDING" 2>/dev/null || echo 0) )); then
        undo_pending
        return 0
    fi
    echo "koompi-displays: a refresh-rate change is waiting for an answer; run 'koompi-displays keep' or 'revert' first" >&2
    exit 1
}

# runs in its own session, so closing Settings or a black screen cannot stop it; counts sleeps, a clock step cannot stretch it
cmd_expire() {
    local token="${1:-}" i
    for ((i = 0; i < CONFIRM_SECONDS * 4; i++)); do
        [ -e "$PENDING" ] || return 0
        sleep 0.25
    done
    [ "$(jq -r .token "$PENDING" 2>/dev/null)" = "$token" ] || return 0
    undo_pending
}

arm_pending() {
    local record="$1" target="$2" token="$$.$RANDOM$RANDOM" deadline now
    command -v setsid >/dev/null 2>&1 || { echo "koompi-displays: setsid (util-linux) is needed to guard the change" >&2; exit 1; }
    printf -v now '%(%s)T' -1
    deadline=$((now + CONFIRM_SECONDS))
    jq -c --arg t "$token" --argjson d "$deadline" --argjson n "$target" \
        '{monitor, mode, x, y, scale, centi} + {target: $n, token: $t, deadline: $d}' <<< "$record" > "$PENDING.new"
    mv -- "$PENDING.new" "$PENDING"
    setsid -f bash "$SELF" _expire "$token" </dev/null >/dev/null 2>&1
}

# ponytail: pairwise placement only; monitors beyond the pair keep their absolute spots
cmd_place() {
    local mon="${1:-}" dir="${2:-}" anchor="${3:-}" monjson
    [ -n "$mon" ] && [ -n "$dir" ] || usage
    refuse_if_pending

    monjson=$(hyprctl monitors -j)

    if [ -z "$anchor" ]; then
        anchor=$(jq -r --arg m "$mon" \
            '[.[] | select(.name != $m)] | (map(select(.name | startswith("eDP"))) + .)[0].name // empty' <<< "$monjson")
    fi
    if [ -z "$anchor" ] || [ "$anchor" = "$mon" ]; then
        echo "koompi-displays: no anchor monitor to place against" >&2
        exit 1
    fi

    # Logical (scale-aware) sizes.
    local aw ah mw mh
    read -r aw ah <<< "$(jq -r --arg a "$anchor" \
        '.[] | select(.name == $a) | "\(.width/.scale|floor) \(.height/.scale|floor)"' <<< "$monjson")"
    read -r mw mh <<< "$(jq -r --arg m "$mon" \
        '.[] | select(.name == $m) | "\(.width/.scale|floor) \(.height/.scale|floor)"' <<< "$monjson")"
    [ -n "$aw" ] && [ -n "$mw" ] || { echo "koompi-displays: unknown monitor" >&2; exit 1; }

    # Anchor at origin, monitor beside it, then shift both non-negative.
    local mx my
    case "$dir" in
        left)  mx=$((-mw)); my=0 ;;
        right) mx=$aw;      my=0 ;;
        above) mx=0; my=$((-mh)) ;;
        below) mx=0; my=$ah ;;
        *) usage ;;
    esac
    local shiftx=$(( mx < 0 ? -mx : 0 )) shifty=$(( my < 0 ? -my : 0 ))
    local ax=$shiftx ay=$shifty
    mx=$((mx+shiftx)); my=$((my+shifty))

    apply_one "$monjson" "$anchor" "$ax" "$ay"
    apply_one "$monjson" "$mon" "$mx" "$my"

    sleep 0.3
    persist_layout
}

cmd_rate() {
    local mon="${1:-}" hz="${2:-}" row centi rate listed w h x y scale
    [ -n "$mon" ] && [ -n "$hz" ] || usage
    [[ $hz =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "koompi-displays: '$hz' is not a refresh rate in Hz" >&2; exit 1; }
    need_state
    refuse_if_pending

    # rates are centi-Hz integers so 74.97 compares exactly; only modes at the current WxH count
    row=$(hyprctl monitors -j | jq -c --arg m "$mon" "$JQ_MODE"'
        .[] | select(.name == $m) | . as $mon
        | {monitor: .name, w: .width, h: .height, x: .x, y: .y, scale: .scale, mode: mode, centi: (.refreshRate * 100 | round),
           rates: ([.availableModes[]?
                    | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@(?<r>[0-9.]+)Hz$")
                    | select((.w | tonumber) == $mon.width and (.h | tonumber) == $mon.height)
                    | (.r | tonumber) * 100 | round] | unique)}')
    [ -n "$row" ] || { echo "koompi-displays: unknown monitor $mon" >&2; exit 1; }

    centi=$(jq -n --arg hz "$hz" '$hz | tonumber * 100 | round')
    if ! jq -e --argjson c "$centi" '.rates | index($c)' <<< "$row" >/dev/null; then
        listed=$(jq -r '.rates | reverse | map(. / 100) | join(" ")' <<< "$row")
        echo "koompi-displays: $mon does not list $hz Hz at its current resolution (listed: ${listed:-none})" >&2
        exit 1
    fi

    printf -v rate '%d.%02d' $((centi / 100)) $((centi % 100))
    read -r w h x y scale <<< "$(jq -r '"\(.w) \(.h) \(.x) \(.y) \(.scale)"' <<< "$row")"
    arm_pending "$row" "$centi"
    if ! apply_mode "$mon" "${w}x${h}@${rate}" "$x" "$y" "$scale" || ! wait_for_rate "$mon" "$centi"; then
        undo_pending
        echo "koompi-displays: $mon did not switch to $hz Hz" >&2
        exit 1
    fi
    print_pending
}

cmd_keep() {
    local claim mon target
    need_state
    claim=$(claim_pending) || { echo "koompi-displays: no refresh-rate change is waiting; it already went back" >&2; exit 1; }
    read -r mon target <<< "$(jq -r '"\(.monitor) \(.target)"' "$claim")"
    if ! wait_for_rate "$mon" "$target"; then
        restore_from "$claim" || true
        echo "koompi-displays: $mon is no longer at the new refresh rate, nothing was saved" >&2
        exit 1
    fi
    if ! persist_layout; then
        restore_from "$claim" || true
        exit 1
    fi
    rm -f -- "$claim"
}

cmd_revert() {
    local claim
    need_state
    claim=$(claim_pending) || exit 0
    restore_from "$claim"
}

case "${1:-}" in
    place) shift; cmd_place "$@" ;;
    rate) shift; cmd_rate "$@" ;;
    keep) cmd_keep ;;
    revert) cmd_revert ;;
    _expire) shift; cmd_expire "$@" ;;
    *) usage ;;
esac
