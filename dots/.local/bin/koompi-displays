#!/usr/bin/env bash
# koompi-displays - monitor arrangement for KOOMPI Settings.
#
#   koompi-displays place <monitor> <left|right|above|below> [anchor]
#   koompi-displays rate <monitor> <hz>
#
# place positions <monitor> relative to <anchor> (default: the internal eDP
# panel, else the first other monitor). rate switches <monitor> to <hz> at its
# current resolution and refuses a rate it does not list there. Both hot-apply
# via `hyprctl eval hl.monitor` and persist the resulting layout to
# ~/.config/hypr/monitors.lua.
# ponytail: pairwise placement only; monitors beyond the pair keep their
# absolute spots. A drag canvas can replace this if 3+ monitor setups matter.
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
MONITORS_LUA="$XDG_CONFIG_HOME/hypr/monitors.lua"
# two decimals like the compositor lists them; one cannot tell 74.97 from 75.00
JQ_MODE='def mode: "\(.width)x\(.height)@\(.refreshRate*100|round/100)";'

usage() {
    echo "usage: koompi-displays place <monitor> <left|right|above|below> [anchor]" >&2
    echo "       koompi-displays rate <monitor> <hz>" >&2
    exit 1
}

# no koompi package depends on lua; the file is a fixed template filled by jq
validate_lua() {
    if command -v luac >/dev/null 2>&1; then
        luac -p "$1" 2>/dev/null
    elif command -v lua >/dev/null 2>&1; then
        lua -e "assert(loadfile('$1'))" 2>/dev/null
    fi
}

persist_layout() {
    local rules tmp
    rules=$(hyprctl monitors -j | jq -r "$JQ_MODE"'.[] |
        "hl.monitor({\n    output = \"\(.name)\",\n    mode = \"\(mode)\",\n    position = \"\(.x)x\(.y)\",\n    scale = \(.scale)\n})"')
    tmp=$(mktemp "$MONITORS_LUA.XXXXXX")
    printf -- '-- Generated by koompi-displays on %s. Do not edit manually.\n\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$rules" > "$tmp"
    if validate_lua "$tmp"; then
        mv "$tmp" "$MONITORS_LUA"
    else
        rm -f "$tmp"
        echo "koompi-displays: generated monitors.lua failed lua validation, not persisted" >&2
        exit 1
    fi
}

apply_one() {
    local monjson="$1" name="$2" x="$3" y="$4" mode scale
    mode=$(jq -r --arg n "$name" "$JQ_MODE"'.[] | select(.name == $n) | mode' <<< "$monjson")
    scale=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .scale' <<< "$monjson")
    hyprctl eval "hl.monitor({output = \"$name\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale})" >/dev/null
}

cmd_place() {
    local mon="${1:-}" dir="${2:-}" anchor="${3:-}" monjson
    [ -n "$mon" ] && [ -n "$dir" ] || usage

    monjson=$(hyprctl monitors -j)

    if [ -z "$anchor" ]; then
        anchor=$(jq -r --arg m "$mon" \
            '[.[] | select(.name != $m)] | (map(select(.name | startswith("eDP"))) + .)[0].name // empty' <<< "$monjson")
    fi
    if [ -z "$anchor" ] || [ "$anchor" = "$mon" ]; then
        echo "koompi-displays: no anchor monitor to place against" >&2
        exit 1
    fi

    # Logical (scale-aware) sizes.
    local aw ah mw mh
    read -r aw ah <<< "$(jq -r --arg a "$anchor" \
        '.[] | select(.name == $a) | "\(.width/.scale|floor) \(.height/.scale|floor)"' <<< "$monjson")"
    read -r mw mh <<< "$(jq -r --arg m "$mon" \
        '.[] | select(.name == $m) | "\(.width/.scale|floor) \(.height/.scale|floor)"' <<< "$monjson")"
    [ -n "$aw" ] && [ -n "$mw" ] || { echo "koompi-displays: unknown monitor" >&2; exit 1; }

    # Anchor at origin, monitor beside it, then shift both non-negative.
    local mx my
    case "$dir" in
        left)  mx=$((-mw)); my=0 ;;
        right) mx=$aw;      my=0 ;;
        above) mx=0; my=$((-mh)) ;;
        below) mx=0; my=$ah ;;
        *) usage ;;
    esac
    local shiftx=$(( mx < 0 ? -mx : 0 )) shifty=$(( my < 0 ? -my : 0 ))
    local ax=$shiftx ay=$shifty
    mx=$((mx+shiftx)); my=$((my+shifty))

    apply_one "$monjson" "$anchor" "$ax" "$ay"
    apply_one "$monjson" "$mon" "$mx" "$my"

    sleep 0.3
    persist_layout
}

# the compositor's own report decides: a hyprctl that exits 0 can still have changed nothing
wait_for_rate() {
    local mon="$1" centi="$2"
    for _ in 1 2 3 4 5 6 7 8; do
        if hyprctl monitors -j | jq -e --arg m "$mon" --argjson c "$centi" \
            '.[] | select(.name == $m) | ((.refreshRate * 100 | round) - $c) as $d | $d >= -1 and $d <= 1' >/dev/null; then
            return 0
        fi
        sleep 0.3
    done
    return 1
}

cmd_rate() {
    local mon="${1:-}" hz="${2:-}" row centi rate listed w h x y scale
    [ -n "$mon" ] && [ -n "$hz" ] || usage
    [[ $hz =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "koompi-displays: '$hz' is not a refresh rate in Hz" >&2; exit 1; }

    # rates are centi-Hz integers so 74.97 compares exactly; only modes at the current WxH count
    row=$(hyprctl monitors -j | jq -c --arg m "$mon" '
        .[] | select(.name == $m) | . as $mon
        | {w: .width, h: .height, x: .x, y: .y, scale: .scale,
           rates: ([.availableModes[]?
                    | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@(?<r>[0-9.]+)Hz$")
                    | select((.w | tonumber) == $mon.width and (.h | tonumber) == $mon.height)
                    | (.r | tonumber) * 100 | round] | unique)}')
    [ -n "$row" ] || { echo "koompi-displays: unknown monitor $mon" >&2; exit 1; }

    centi=$(jq -n --arg hz "$hz" '$hz | tonumber * 100 | round')
    if ! jq -e --argjson c "$centi" '.rates | index($c)' <<< "$row" >/dev/null; then
        listed=$(jq -r '.rates | reverse | map(. / 100) | join(" ")' <<< "$row")
        echo "koompi-displays: $mon does not list $hz Hz at its current resolution (listed: ${listed:-none})" >&2
        exit 1
    fi

    read -r w h x y scale <<< "$(jq -r '"\(.w) \(.h) \(.x) \(.y) \(.scale)"' <<< "$row")"
    printf -v rate '%d.%02d' $((centi / 100)) $((centi % 100))
    hyprctl eval "hl.monitor({output = \"$mon\", mode = \"${w}x${h}@${rate}\", position = \"${x}x${y}\", scale = $scale})" >/dev/null
    wait_for_rate "$mon" "$centi" || { echo "koompi-displays: $mon did not switch to $rate Hz, layout not saved" >&2; exit 1; }
    persist_layout
}

case "${1:-}" in
    place) shift; cmd_place "$@" ;;
    rate) shift; cmd_rate "$@" ;;
    *) usage ;;
esac
