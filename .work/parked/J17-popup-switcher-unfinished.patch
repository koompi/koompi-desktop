diff --git a/tests/test_app_switcher_binds.sh b/tests/test_app_switcher_binds.sh
new file mode 100644
index 000000000..16393562d
--- /dev/null
+++ b/tests/test_app_switcher_binds.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+# Alt+Tab binds (docs/navigation.md, App switcher): replayed from the shipped keybinds.lua under a recording `hl`.
+# The Alt chords dispatch the switcher's global shortcuts, share one cheatsheet description, enter the
+# appswitcher submap, and inside it Tab, Q, Escape, the arrows and both Alt releases mean switcher actions.
+# Super+Tab stays the overview. Every global the binds name is declared by a GlobalShortcut in the shell.
+set -uo pipefail
+
+REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+HYPR="$REPO_ROOT/dots/.config/hypr"
+SWITCHER="$REPO_ROOT/dots/.config/quickshell/koompi/modules/koompi/appSwitcher"
+
+fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
+
+command -v lua > /dev/null 2>&1 || { echo "skip: lua not installed, binds not replayed"; exit 0; }
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+cat > "$WORK/replay.lua" <<'LUA'
+package.path = arg[1] .. "/?.lua;" .. arg[1] .. "/?/init.lua;" .. package.path
+local submap, records = "", {}
+local function proxy(path)
+    return setmetatable({}, {
+        __index = function(_, k) return proxy(path .. "." .. tostring(k)) end,
+        __call = function(_, a) return { expr = path .. "(" .. tostring(type(a) == "string" and a or "") .. ")" } end,
+    })
+end
+local anything
+anything = setmetatable({}, {
+    __index = function(_, k) if type(k) == "number" then return nil end return anything end,
+    __call = function() return anything end,
+})
+hl = setmetatable({}, { __index = function() return anything end })
+hl.dsp = proxy("dsp")
+hl.dispatch = function() end
+function hl.bind(keys, dispatcher, opts)
+    opts = opts or {}
+    records[#records + 1] = {
+        keys = keys, submap = submap, description = opts.description or "", release = opts.release and 1 or 0,
+        ignore_mods = opts.ignore_mods and 1 or 0, repeating = opts.repeating and 1 or 0,
+        expr = type(dispatcher) == "table" and dispatcher.expr or "function",
+    }
+end
+function hl.define_submap(name, fn)
+    local previous = submap
+    submap = name
+    fn()
+    submap = previous
+end
+require("hyprland.keybinds")
+for _, r in ipairs(records) do
+    print(table.concat({ r.keys, r.submap, r.expr, r.description, r.release, r.ignore_mods, r.repeating }, "|"))
+end
+LUA
+
+(cd "$WORK" && lua replay.lua "$HYPR") > "$WORK/binds.txt" 2> "$WORK/err.txt" || { cat "$WORK/err.txt" >&2; fail "keybinds.lua did not replay under the recording hl"; }
+
+has() { grep -qxF -- "$1" "$WORK/binds.txt"; }
+want() { has "$2" || { cat "$WORK/binds.txt" | grep -i 'alt' >&2; fail "$1: missing '$2'"; }; }
+
+want "Alt+Tab is the switcher" 'ALT + Tab||dsp.global(quickshell:appSwitcherNext)|Window: Switch windows (hold Alt)|0|0|0'
+want "Alt+Shift+Tab is the switcher, same description" 'ALT + SHIFT + Tab||dsp.global(quickshell:appSwitcherPrev)|Window: Switch windows (hold Alt)|0|0|0'
+want "Alt+grave cycles this app" "ALT + grave||dsp.global(quickshell:appSwitcherSameNext)|Window: Cycle this app's windows (hold Alt)|0|0|0"
+want "Alt+Shift+grave cycles this app backwards" "ALT + SHIFT + grave||dsp.global(quickshell:appSwitcherSamePrev)|Window: Cycle this app's windows (hold Alt)|0|0|0"
+want "Alt+Tab also enters the submap" 'ALT + Tab||function||0|0|0'
+want "Alt+Shift+grave also enters the submap" 'ALT + SHIFT + grave||function||0|0|0'
+want "Tab steps inside the submap" 'ALT + Tab|appswitcher|dsp.global(quickshell:appSwitcherNext)||0|0|1'
+want "Shift+Tab steps back inside the submap" 'ALT + SHIFT + Tab|appswitcher|dsp.global(quickshell:appSwitcherPrev)||0|0|1'
+want "Right steps" 'ALT + Right|appswitcher|dsp.global(quickshell:appSwitcherNext)||0|0|1'
+want "Left steps back" 'ALT + Left|appswitcher|dsp.global(quickshell:appSwitcherPrev)||0|0|1'
+want "Down opens the window row" 'ALT + Down|appswitcher|dsp.global(quickshell:appSwitcherDown)||0|0|0'
+want "Up leaves the window row" 'ALT + Up|appswitcher|dsp.global(quickshell:appSwitcherUp)||0|0|0'
+want "Q closes" 'ALT + Q|appswitcher|dsp.global(quickshell:appSwitcherClose)||0|0|0'
+want "Escape cancels and leaves the submap" 'ALT + Escape|appswitcher|function||0|0|0'
+want "left Alt release commits and leaves the submap" 'ALT_L|appswitcher|function||1|1|0'
+want "right Alt release commits and leaves the submap" 'ALT_R|appswitcher|function||1|1|0'
+want "Super+Tab stays the overview" 'SUPER + Tab||dsp.global(quickshell:overviewWorkspacesToggle)|Shell: Toggle overview|0|0|0'
+echo "ok   keybinds.lua: Alt+Tab, Alt+grave, the appswitcher submap, both Alt releases, Super+Tab untouched"
+
+while IFS= read -r name; do
+    grep -q "name: \"$name\"" "$SWITCHER/AppSwitcher.qml" || fail "a bind dispatches quickshell:$name but AppSwitcher.qml declares no such GlobalShortcut"
+done < <(grep -o 'appSwitcher[A-Za-z]*' "$HYPR/hyprland/keybinds.lua" | sort -u | grep -v '^appSwitcher$')
+echo "ok   every global the binds name is a GlobalShortcut in AppSwitcher.qml"
