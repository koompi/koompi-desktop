 end
 
+--##! App switcher
+-- Alt+Tab enters the appswitcher submap, so Tab, Q, Escape and the arrows mean switcher actions only while Alt is held;
+-- releasing Alt commits and leaves it. The submap is left from Lua too, so a dead shell cannot strand the keyboard in it.
+local function switcherEnd(action)
+    return function()
+        hl.dispatch(hl.dsp.global("quickshell:appSwitcher" .. action))
+        hl.dispatch(hl.dsp.submap("reset"))
+    end
+end
+local function switcherEnter(chord, action, shift)
+    hl.bind(chord, hl.dsp.global("quickshell:appSwitcher" .. action),
+        { description = shift and "Window: Cycle this app's windows (hold Alt)" or "Window: Switch windows (hold Alt)" })
+    hl.bind(chord, function() hl.dispatch(hl.dsp.submap("appswitcher")) end) -- # [hidden] enter the submap
+end
+switcherEnter("ALT + Tab", "Next", false)
+switcherEnter("ALT + SHIFT + Tab", "Prev", false)
+switcherEnter("ALT + grave", "SameNext", true)
+switcherEnter("ALT + SHIFT + grave", "SamePrev", true)
+hl.define_submap("appswitcher", function()
+    hl.bind("ALT + Tab", hl.dsp.global("quickshell:appSwitcherNext"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + SHIFT + Tab", hl.dsp.global("quickshell:appSwitcherPrev"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + grave", hl.dsp.global("quickshell:appSwitcherSameNext"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + SHIFT + grave", hl.dsp.global("quickshell:appSwitcherSamePrev"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + Right", hl.dsp.global("quickshell:appSwitcherNext"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + Left", hl.dsp.global("quickshell:appSwitcherPrev"), { repeating = true }) -- # [hidden]
+    hl.bind("ALT + Down", hl.dsp.global("quickshell:appSwitcherDown")) -- # [hidden]
+    hl.bind("ALT + Up", hl.dsp.global("quickshell:appSwitcherUp")) -- # [hidden]
+    hl.bind("ALT + Q", hl.dsp.global("quickshell:appSwitcherClose")) -- # [hidden]
+    hl.bind("ALT + Escape", switcherEnd("Cancel")) -- # [hidden]
+    hl.bind("ALT_L", switcherEnd("Commit"), { release = true, ignore_mods = true }) -- # [hidden]
+    hl.bind("ALT_R", switcherEnd("Commit"), { release = true, ignore_mods = true }) -- # [hidden]
+end)
+
 --##! Virtual machines
 hl.define_submap("virtual-machine", function()
     hl.bind("SUPER + ALT + F1", function()
