+#!/usr/bin/env bash
+# Alt+Tab walks windows, current workspace first, most recent first (docs/navigation.md, App switcher).
+# The ordering, the wrap and the first-press index are modules/koompi/appSwitcher/app-switcher-model.js, run here
+# on a window list shaped like koompi-shelld's `clients`: focusHistoryID, class, workspace, one special-workspace window.
+set -uo pipefail
+
+REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+MODEL="$REPO_ROOT/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/app-switcher-model.js"
+
+fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
+
+[[ -f "$MODEL" ]] || fail "missing ${MODEL#"$REPO_ROOT"/}"
+if grep -nE '\.(flatMap|flat|at|replaceAll|findLast|toSorted|toReversed)\(|Object\.(hasOwn|fromEntries)' "$MODEL"; then
+    fail "app-switcher-model.js uses a method the Quickshell JS engine lacks"
+fi
+if command -v bun > /dev/null 2>&1; then RUNNER=bun
+elif command -v node > /dev/null 2>&1; then RUNNER=node
+else echo "skip: neither bun nor node installed, app-switcher-model.js not run"; exit 0
+fi
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+sed '/^\.pragma /d' "$MODEL" > "$WORK/model.mjs"
+printf '\nexport { build, step, startIndex, focusedAppId, ofApp, siblings, without };\n' >> "$WORK/model.mjs"
+
+cat > "$WORK/run.mjs" <<'EOF'
+import { build, step, startIndex, focusedAppId, ofApp, siblings, without } from "./model.mjs";
+
+let failed = 0;
+const check = (name, cond, extra = "") => {
+    if (!cond) { console.error(`FAIL: ${name} ${extra}`); failed++; }
+};
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+
+const win = (address, cls, title, ws, hist, extra = {}) => ({
+    address, class: cls, title, mapped: true, hidden: false, focusHistoryID: hist,
+    workspace: { id: ws, name: String(ws) }, ...extra,
+});
+const windows = [
+    win("0xa1", "kitty", "shell", 1, 3),
+    win("0xb1", "firefox", "docs", 1, 1),
+    win("0xa2", "kitty", "logs", 1, 0),
+    win("0xc1", "okular", "paper", 2, 2),
+    win("0xd1", "kitty", "other", 3, 4),
+    win("0xe1", "pavucontrol", "scratch", -98, 5, { workspace: { id: -98, name: "special:magic" } }),
+    win("0xf1", "gimp", "never focused", 1, -1),
+    win("0x01", "zoom", "unmapped", 1, 6, { mapped: false }),
+];
+const appOf = w => ({ id: w.class, name: w.class, icon: w.class });
+const entries = build(windows, 1, appOf);
+const order = list => list.map(e => e.address);
+
+check("current workspace first, most recent first, then the rest by recency, never-focused last of its group",
+    same(order(entries), ["0xa2", "0xb1", "0xa1", "0xf1", "0xc1", "0xd1"]), JSON.stringify(order(entries)));
+check("a special-workspace window is skipped", !order(entries).includes("0xe1"));
+check("an unmapped window is skipped", !order(entries).includes("0x01"));
+check("windows elsewhere are marked, windows here are not",
+    same(entries.map(e => e.here), [true, true, true, true, false, false]));
+check("an entry carries its workspace number", entries[4].workspace === 2 && entries[5].workspace === 3);
+
+check("the first press lands on index 1, the previous window", startIndex(entries.length, 1) === 1);
+check("the first Shift press lands on the oldest", startIndex(entries.length, -1) === entries.length - 1);
+check("one window: the first press stays on it", startIndex(1, 1) === 0);
+check("next wraps past the end", step(entries.length - 1, entries.length, 1) === 0);
+check("prev wraps past the start", step(0, entries.length, -1) === entries.length - 1);
+check("next steps by one", step(2, entries.length, 1) === 3);
+check("an empty list steps to 0", step(0, 0, 1) === 0);
+
+check("the focused app is the one with the most recent window", focusedAppId(entries) === "kitty");
+check("Alt+grave walks only the focused app's windows, current workspace first",
+    same(order(ofApp(entries, "kitty")), ["0xa2", "0xa1", "0xd1"]));
+check("siblings are the indexes of one app's windows", same(siblings(entries, "kitty"), [0, 2, 5]));
+
+const left = without(entries, "0xa2", 0);
+check("closing a window drops it and keeps the selection in range",
+    !order(left.entries).includes("0xa2") && left.index === 0);
+check("closing the last entry leaves index 0", without(entries.slice(0, 1), "0xa2", 0).index === 0);
+check("closing the final window empties the list", without(entries.slice(0, 1), "0xa2", 0).entries.length === 0);
+check("closing the last row moves the selection back", without(entries, "0xd1", 5).index === 4);
+
+if (failed) process.exit(1);
+console.log("ok   app-switcher-model: order, skips, first-press index, wrap, Alt+grave, close");
+EOF
+
+cd "$WORK" && "$RUNNER" run.mjs || fail "app-switcher-model.js"
