diff --git a/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/AppSwitcher.qml b/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/AppSwitcher.qml
new file mode 100644
index 000000000..c6cbcf58d
--- /dev/null
+++ b/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/AppSwitcher.qml
@@ -0,0 +1,247 @@
+import qs
+import qs.services
+import qs.modules.common
+import "app-switcher-model.js" as Model
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Quickshell.Hyprland
+
+// Alt+Tab. The keys, the state and the IPC live here and answer with no window; the window is built on the
+// first press and only drawn once Alt has been held for showDelay, so a quick tap draws nothing.
+Scope {
+    id: root
+    readonly property bool built: surface.item !== null
+
+    property bool active: false
+    // Alt+grave: the same walk over one app's windows, never drawn
+    property bool quiet: false
+    property var entries: []
+    property int index: 0
+    property var kin: []
+    property int rowIndex: 0
+    property bool rowShown: false
+    property bool rowFocus: false
+    property string screenName: ""
+    property int showDelay: 120
+    property int rowDelay: 300
+
+    readonly property var current: root.entries[root.index] ?? null
+    readonly property var picked: root.entries[root.rowFocus ? root.kin[root.rowIndex] : root.index] ?? null
+
+    function appOf(win) {
+        const entry = DesktopEntries.heuristicLookup(win.class);
+        return {
+            id: entry?.id ?? win.class,
+            name: entry?.name ?? win.class,
+            icon: entry?.icon ?? AppSearch.guessIcon(win.class)
+        };
+    }
+
+    function begin(dir: int, sameApp: bool): void {
+        const here = Hyprland.focusedWorkspace?.id ?? HyprlandData.activeWorkspace?.id ?? -1;
+        let list = Model.build(HyprlandData.windowList, here, win => root.appOf(win));
+        if (sameApp)
+            list = Model.ofApp(list, Model.focusedAppId(list));
+        if (list.length === 0)
+            return;
+        root.screenName = Hyprland.focusedMonitor?.name ?? "";
+        root.entries = list;
+        root.index = Model.startIndex(list.length, dir);
+        root.quiet = sameApp;
+        root.active = true;
+        root.rowFocus = false;
+        root.reselect();
+        if (!sameApp)
+            showTimer.restart();
+    }
+
+    function reselect(): void {
+        root.rowShown = false;
+        root.kin = root.current ? Model.siblings(root.entries, root.current.appId) : [];
+        root.rowIndex = Math.max(0, root.kin.indexOf(root.index));
+        rowTimer.stop();
+        if (!root.quiet && root.kin.length > 1)
+            rowTimer.restart();
+    }
+
+    function move(dir: int): void {
+        if (!root.active) {
+            root.begin(dir, false);
+        } else if (root.rowFocus) {
+            root.rowIndex = Model.step(root.rowIndex, root.kin.length, dir);
+        } else {
+            root.index = Model.step(root.index, root.entries.length, dir);
+            root.reselect();
+        }
+    }
+
+    function moveSameApp(dir: int): void {
+        if (root.active)
+            root.move(dir);
+        else
+            root.begin(dir, true);
+    }
+
+    function down(): void {
+        if (!root.active || root.quiet || root.kin.length < 2)
+            return;
+        rowTimer.stop();
+        root.rowShown = true;
+        root.rowFocus = true;
+    }
+
+    function up(): void {
+        root.rowFocus = false;
+        root.rowIndex = Math.max(0, root.kin.indexOf(root.index));
+    }
+
+    function finish(): void {
+        showTimer.stop();
+        rowTimer.stop();
+        root.active = false;
+        root.rowShown = false;
+        root.rowFocus = false;
+        GlobalStates.appSwitcherOpen = false;
+        Hyprland.dispatch('hl.dsp.submap("reset")');
+    }
+
+    function commit(): void {
+        if (!root.active)
+            return;
+        const target = root.picked?.address ?? "";
+        root.finish();
+        if (target !== "")
+            Hyprland.dispatch(`hl.dsp.focus({ window = "address:${target}" })`);
+    }
+
+    function cancel(): void {
+        if (root.active)
+            root.finish();
+    }
+
+    function closeSelected(): void {
+        const target = root.picked?.address ?? "";
+        if (!root.active || target === "")
+            return;
+        Hyprland.dispatch(`hl.dsp.window.close({ window = "address:${target}" })`);
+        const left = Model.without(root.entries, target, root.index);
+        if (left.entries.length === 0) {
+            root.finish();
+            return;
+        }
+        root.rowFocus = false;
+        root.entries = left.entries;
+        root.index = left.index;
+        root.reselect();
+        if (root.kin.length > 1)
+            root.rowShown = true;
+    }
+
+    Timer {
+        id: showTimer
+        interval: root.showDelay
+        onTriggered: GlobalStates.appSwitcherOpen = root.active && !root.quiet
+    }
+
+    Timer {
+        id: rowTimer
+        interval: root.rowDelay
+        onTriggered: root.rowShown = root.active && root.kin.length > 1
+    }
+
+    LazySurface {
+        id: surface
+        open: root.active
+        component: AppSwitcherWindow {
+            switcher: root
+        }
+    }
+
+    IpcHandler {
+        target: "appSwitcher"
+
+        function next(): void {
+            root.move(1);
+        }
+
+        function prev(): void {
+            root.move(-1);
+        }
+
+        function commit(): void {
+            root.commit();
+        }
+
+        function cancel(): void {
+            root.cancel();
+        }
+
+        function selection(): string {
+            return root.current?.appId ?? "";
+        }
+
+        function window(): string {
+            return root.picked?.address ?? "";
+        }
+
+        function shown(): bool {
+            return GlobalStates.appSwitcherOpen;
+        }
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherNext"
+        description: "Alt+Tab: next window"
+        onPressed: root.move(1)
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherPrev"
+        description: "Alt+Shift+Tab: previous window"
+        onPressed: root.move(-1)
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherSameNext"
+        description: "Alt+grave: next window of this app"
+        onPressed: root.moveSameApp(1)
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherSamePrev"
+        description: "Alt+Shift+grave: previous window of this app"
+        onPressed: root.moveSameApp(-1)
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherDown"
+        description: "Switcher: choose among this app's windows"
+        onPressed: root.down()
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherUp"
+        description: "Switcher: back to the apps"
+        onPressed: root.up()
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherClose"
+        description: "Switcher: close the selected window"
+        onPressed: root.closeSelected()
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherCancel"
+        description: "Switcher: cancel"
+        onPressed: root.cancel()
+    }
+
+    GlobalShortcut {
+        name: "appSwitcherCommit"
+        description: "Alt released: go to the selected window"
+        onPressed: root.commit()
+        onReleased: root.commit()
+    }
+}
