+import qs
+import qs.modules.common
+import qs.modules.common.widgets
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Wayland
+
+PanelWindow {
+    id: win
+
+    required property var switcher
+    readonly property real tileStep: 100
+    readonly property real maxGrid: Math.max(win.tileStep * 4, (win.screen?.width ?? 1280) - 160)
+    readonly property int columns: Math.max(1, Math.min(win.switcher.entries.length, Math.floor((win.maxGrid + 8) / win.tileStep)))
+    readonly property real gridWidth: win.columns * win.tileStep - 8
+
+    visible: GlobalStates.appSwitcherOpen
+    screen: Quickshell.screens.find(s => s.name === win.switcher.screenName) ?? Quickshell.screens[0] ?? null
+    color: "transparent"
+    exclusionMode: ExclusionMode.Ignore
+    implicitWidth: panel.width
+    implicitHeight: panel.height
+    mask: Region {}
+    WlrLayershell.namespace: "quickshell:appSwitcher"
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+
+    Rectangle {
+        id: panel
+        objectName: "appSwitcherPanel"
+        width: Math.max(win.gridWidth, win.tileStep * 4 - 8) + 40
+        height: content.implicitHeight + 40
+        radius: Appearance.rounding.windowRounding
+        color: Appearance.colors.colLayer0
+        border.width: 1
+        border.color: Appearance.colors.colLayer0Border
+
+        ColumnLayout {
+            id: content
+            anchors {
+                left: parent.left
+                right: parent.right
+                top: parent.top
+                margins: 20
+            }
+            spacing: 14
+
+            Flow {
+                Layout.alignment: Qt.AlignHCenter
+                Layout.preferredWidth: win.gridWidth
+                spacing: 8
+
+                Repeater {
+                    model: win.switcher.entries
+                    delegate: AppSwitcherTile {
+                        required property var modelData
+                        required property int index
+                        entry: modelData
+                        selected: index === win.switcher.index
+                    }
+                }
+            }
+
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+
+                StyledText {
+                    Layout.fillWidth: true
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    font.pixelSize: Appearance.font.pixelSize.larger
+                    font.weight: Font.Medium
+                    text: win.switcher.current?.appName ?? ""
+                }
+
+                StyledText {
+                    Layout.fillWidth: true
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    color: Appearance.colors.colSubtext
+                    text: {
+                        const entry = win.switcher.picked;
+                        if (!entry)
+                            return "";
+                        return entry.here ? entry.title : Translation.tr("Workspace %1").arg(entry.workspace) + "  ·  " + entry.title;
+                    }
+                }
+            }
+
+            Row {
+                id: windowRow
+                objectName: "appSwitcherWindows"
+                Layout.alignment: Qt.AlignHCenter
+                visible: win.switcher.rowShown
+                spacing: 8
+
+                Repeater {
+                    model: win.switcher.kin
+                    delegate: Rectangle {
+                        id: chip
+                        required property int modelData
+                        required property int index
+                        readonly property var entry: win.switcher.entries[chip.modelData]
+                        readonly property bool chosen: chip.index === win.switcher.rowIndex
+                        width: Math.min(220, chipText.implicitWidth + 24)
+                        height: 32
+                        radius: Appearance.rounding.full
+                        color: chip.chosen && win.switcher.rowFocus ? Appearance.colors.colPrimaryContainer : Appearance.colors.colLayer2
+                        border.width: chip.chosen ? 2 : 0
+                        border.color: Appearance.colors.colPrimary
+
+                        StyledText {
+                            id: chipText
+                            anchors {
+                                fill: parent
+                                leftMargin: 12
+                                rightMargin: 12
+                            }
+                            elide: Text.ElideRight
+                            text: (chip.entry?.here ? "" : chip.entry?.workspace + "  ") + (chip.entry?.title ?? "")
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/app-switcher-model.js b/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/app-switcher-model.js
new file mode 100644
index 000000000..eb6cecdbb
--- /dev/null
+++ b/dots/.config/quickshell/koompi/modules/koompi/appSwitcher/app-switcher-model.js
@@ -0,0 +1,81 @@
+.pragma library
+
+// Windows the switcher walks, most recent first. The current workspace's windows lead
+// because tiles sit side by side there; windows elsewhere follow, marked with their workspace.
+
+function rank(win) {
+    return win.focusHistoryID < 0 ? 1000000 : win.focusHistoryID;
+}
+
+function switchable(win) {
+    if (!win.mapped || win.hidden)
+        return false;
+    const ws = win.workspace;
+    return !!ws && ws.id >= 0 && String(ws.name).indexOf("special") !== 0;
+}
+
+// appOf(win) -> { id, name, icon }
+function build(windows, currentWorkspace, appOf) {
+    const entries = [];
+    for (const win of windows) {
+        if (!switchable(win))
+            continue;
+        const app = appOf(win);
+        entries.push({
+            address: win.address,
+            appId: app.id,
+            appName: app.name,
+            icon: app.icon,
+            title: win.title,
+            workspace: win.workspace.id,
+            here: win.workspace.id === currentWorkspace,
+            rank: rank(win)
+        });
+    }
+    entries.sort((a, b) => {
+        if (a.here !== b.here)
+            return a.here ? -1 : 1;
+        if (a.rank !== b.rank)
+            return a.rank - b.rank;
+        return a.address < b.address ? -1 : 1;
+    });
+    return entries;
+}
+
+function step(index, count, dir) {
+    return count > 0 ? ((index + dir) % count + count) % count : 0;
+}
+
+// the first press lands on the previous window, the first Shift press on the oldest
+function startIndex(count, dir) {
+    return step(0, count, dir);
+}
+
+function focusedAppId(entries) {
+    let best = null;
+    for (const entry of entries)
+        if (best === null || entry.rank < best.rank)
+            best = entry;
+    return best ? best.appId : "";
+}
+
+// Alt+grave: the focused app's windows only, in the same order
+function ofApp(entries, appId) {
+    return entries.filter(entry => entry.appId === appId);
+}
+
+// indexes of every window of one app, for the row under the selection
+function siblings(entries, appId) {
+    const out = [];
+    entries.forEach((entry, i) => {
+        if (entry.appId === appId)
+            out.push(i);
+    });
+    return out;
+}
+
+// the entry list after one window closes, and where the selection lands
+function without(entries, address, index) {
+    const next = entries.filter(entry => entry.address !== address);
+    return { entries: next, index: next.length === 0 ? 0 : Math.min(index, next.length - 1) };
+}
