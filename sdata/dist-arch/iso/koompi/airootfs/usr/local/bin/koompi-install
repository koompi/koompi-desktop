#!/usr/bin/env bash
# Installs KOOMPI Hyprland from the live ISO: archinstall with KOOMPI's defaults
# and profile (/usr/share/koompi/archinstall). The profile leaves a first-boot step
# on the new system that puts the desktop on the account made here, the same way
# the one-line installer does, so every machine updates the same way.
#
# KOOMPI_REF and KOOMPI_REPO pass through to that step (a test install of a branch).

set -euo pipefail

share=/usr/share/koompi/archinstall

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    C_BOLD=$'\e[1m'; C_GREEN=$'\e[32m'; C_RED=$'\e[31m'; C_RST=$'\e[0m'
else
    C_BOLD=''; C_GREEN=''; C_RED=''; C_RST=''
fi

[[ "$(id -u)" -eq 0 ]] || { echo "run koompi-install as root (the live session is root)" >&2; exit 1; }

online() { curl -fsI --max-time 6 https://github.com >/dev/null 2>&1; }

cat <<EOF

${C_BOLD}${C_GREEN}KOOMPI Hyprland installer${C_RST}

  1. Pick the disk (Disk configuration). Everything on it is erased.
     "Use a best-effort default partition layout" with btrfs is the KOOMPI default.
  2. Set your account (Authentication > User account).
  3. Choose Install. When it finishes, choose Reboot.

  The first start of the new system then sets up the KOOMPI desktop. It needs the
  internet and takes 15-40 minutes. Do not switch the machine off while it runs.

EOF

until online; do
    printf '%sNo internet connection.%s Opening the network menu (Wi-Fi: "Activate a connection").\n' "$C_RED" "$C_RST"
    read -rp "Press Enter to continue, or Ctrl+C to stop. " _
    nmtui || true
done

read -rp "Press Enter to start the installer. " _

# The answers the installer cannot know (KOOMPI_REF, KOOMPI_REPO) reach the profile
# through the environment; archinstall runs it in this process.
export KOOMPI_REF="${KOOMPI_REF:-main}"
export KOOMPI_REPO="${KOOMPI_REPO:-https://github.com/koompi/koompi-desktop.git}"
exec archinstall --config "$share/config.json" "$@"
