# KOOMPI Hyprland live/install medium. These go into the live session only; the
# installed system gets its packages from archinstall (koompi_hyprland.py) and the
# desktop from ./setup install on its first boot.
#
# One package per line. Full-line comments only: an inline `# ...` leaves trailing
# whitespace in the package name and breaks pacstrap.

# --- Base system, kernel, firmware -------------------------------------------
base
linux
linux-firmware
linux-firmware-marvell
sof-firmware
amd-ucode
intel-ucode
mkinitcpio
# archiso runtime initramfs hook: finds and mounts the live squashfs at boot
mkinitcpio-archiso

# --- Live boot and shell -----------------------------------------------------
# BIOS boot modules for the syslinux bootmodes; UEFI systemd-boot comes from base
syslinux
# root's ~/.zlogin starts koompi-install
zsh

# --- Installer ---------------------------------------------------------------
# the engine koompi-install drives (disk, encryption, pacstrap, bootloader)
archinstall
arch-install-scripts

# --- What the installer needs in the live session ----------------------------
networkmanager
# Wi-Fi without NetworkManager's menu, for anyone who knows iwctl
iwd
wpa_supplicant
wireless-regdb
btrfs-progs
dosfstools
e2fsprogs
cryptsetup
lvm2
git
curl
sudo
nano
vim
less
jq
gptfdisk
parted
