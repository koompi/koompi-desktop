groups=(koompi)
pkgname=koompi-hyprland
pkgver=1.0
pkgrel=6
pkgdesc='KOOMPI Hyprland compositor, Quickshell + tools (metapackage)'
arch=(any)
license=(None)
# The old local build declared conflicts=(quickshell); replaces= lets pacman
# -Syu swap it out unattended, where the conflict prompt defaults to no.
replaces=(koompi-quickshell-git)
depends=(
  hyprland
  hyprsunset
  wl-clipboard
  # The shell. Arch's own build, which Arch rebuilds with every Qt bump; a local
  # build of it links Qt's private ABI and blocks or breaks each Qt upgrade.
  quickshell
  # Qt modules the KOOMPI shell config imports beyond what quickshell needs.
  qt6-5compat
  qt6-avif-image-plugin
  qt6-imageformats
  qt6-multimedia
  qt6-positioning
  qt6-quicktimeline
  qt6-sensors
  qt6-tools
  qt6-translations
  qt6-virtualkeyboard
  kirigami
  kdialog
  syntax-highlighting
)
