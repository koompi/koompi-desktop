# ttf-koompi-space-grotesk - Space Grotesk, the shell's "expressive" face
# (Config.qml), as Google Fonts' variable TTF.
#
# NOTE (source): the AUR's otf-space-grotesk builds from the 38C3 styleguide, a
# 31 MB zip on events.ccc.de that came down at ~12 KB/s from Cambodia and timed
# out a clean install three times running. This takes the one 137 KB file from
# google/fonts on GitHub, pinned to a commit so the checksum holds.
groups=(koompi)
pkgname=ttf-koompi-space-grotesk
pkgver=2.0.0
pkgrel=1
_commit=00a38a53f92aef923b9353f40128e8f4552ddae4
pkgdesc='Space Grotesk variable font (Google Fonts build) for the KOOMPI shell'
arch=(any)
url='https://github.com/floriankarsten/space-grotesk'
license=('OFL-1.1')
depends=(fontconfig)
source=("SpaceGrotesk.ttf::https://raw.githubusercontent.com/google/fonts/${_commit}/ofl/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf"
        "OFL.txt::https://raw.githubusercontent.com/google/fonts/${_commit}/ofl/spacegrotesk/OFL.txt")
sha256sums=('acad6de1fc93436f5c0f1f4137751ef04f1aea3063e7036535970ffcfbd79f72'
            '564ce565c371c5e5bbf286006565a7c9aa55a9f56e7ca58d56e05d649dd61a72')

package() {
  install -Dm644 SpaceGrotesk.ttf "$pkgdir/usr/share/fonts/TTF/SpaceGrotesk[wght].ttf"
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
