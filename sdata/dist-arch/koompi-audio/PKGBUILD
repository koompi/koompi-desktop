arch=(any)
license=(None)
depends=(
  cava
  pavucontrol-qt
  wireplumber
  pipewire-pulse
  sound-theme-freedesktop
  libdbusmenu-gtk3
  playerctl
  # The sidebar's EasyEffects toggle starts it in service mode, and again at
  # login if it was left on. Without the package the toggle is hidden, so a
  # desktop that means to have equalization could not turn it on.
  easyeffects
)
