// KOOMPI installer - package manifest. No dependencies: rendering is plain
// ANSI and the OS calls are std.os.linux, so nothing is fetched.
.{
    .name = .koompi_installer,
    .fingerprint = 0x07b1b58585e0597d,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
        "README.md",
    },
}
